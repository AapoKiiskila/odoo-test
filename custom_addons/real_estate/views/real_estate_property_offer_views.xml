<?xml version="1.0"?>
<odoo>

    <record id="real_estate_offer_view_form" model="ir.ui.view">
        <field name="name">real.estate.property.offer.form</field>
        <field name="model">real.estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Offer">
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>