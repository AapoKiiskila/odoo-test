<?xml version="1.0"?>
<odoo>

    <record id="real_estate_action_2" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">real.estate.property.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="real_estate_property_type_view_tree" model="ir.ui.view">
        <field name="name">real.estate.property.type.tree</field>
        <field name="model">real.estate.property.type</field>
        <field name="arch" type="xml">
            <tree string="Properties">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="real_estate_property_type_view_form" model="ir.ui.view">
        <field name="name">real.estate.property.type.form</field>
        <field name="model">real.estate.property.type</field>
        <field name="arch" type="xml">
            <form string="Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="action" class="oe_stat_button" name="%(real_estate_action_4)d" string="Offers" icon="fa-money">
                            <field name="offer_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1 class="mb32">
                            <field name="name"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Properties">
                            <field name="property_ids">
                                <tree string="Properties">
                                    <field name="name"/>
                                    <field name="expected_price"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>